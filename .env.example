# ==============================================================================
# İKÜANTS TEKMER — ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyada gerçek değer bulunmaz. Kopyalayıp .env (yerel) veya barındırma
# panelindeki ortam değişkenleri (production) olarak doldurun.
# Gizli anahtar üretmek için: openssl rand -base64 48
# ==============================================================================

# ------------------------------------------------------------------------------
# ZORUNLU
# ------------------------------------------------------------------------------

# PostgreSQL bağlantısı
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Oturum imzalama anahtarı (en az 32 karakter). AUTH_SECRET yoksa JWT_SECRET okunur.
AUTH_SECRET=""

# T.C. kimlik numarası şifreleme anahtarı (en az 32 karakter). Production'da zorunludur.
# Kurulumdan sonra DEĞİŞTİRMEYİN: değişirse mevcut şifreli kimlik numaraları çözülemez.
IDENTITY_ENCRYPTION_KEY=""

# Entegrasyon Merkezi'ne girilen API anahtarı / parola / webhook sırlarını şifreler (en az 32 karakter).
# Production'da zorunludur. Kurulumdan sonra değiştirirseniz kayıtlı bağlantı sırlarını yeniden girmeniz gerekir.
INTEGRATION_ENCRYPTION_KEY=""

# Uygulamanın dış adresi (e-posta bağlantıları ve yönlendirmeler için)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# İLK KURULUM (yalnızca npm run bootstrap:prod / seed sırasında okunur)
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# OPSİYONEL — tanımlanmazsa ilgili özellik "PENDING_EXTERNAL_CONFIGURATION"
# durumunda kalır; sahte "gönderildi / yüklendi" durumu üretilmez.
# ------------------------------------------------------------------------------

# Oturum ayarları
ADMIN_SESSION_COOKIE_NAME="__session"
SESSION_EXPIRY_DAYS="7"

# E-posta (SMTP). Tanımlı değilse e-postalar outbox'ta PENDING olarak bekler.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Yeni başvuru vb. iç bildirimlerin gideceği adresler (virgülle ayrılmış)
ADMIN_NOTIFICATION_EMAIL=""

# Dosya depolama: local (yalnızca geliştirme) | s3 (S3 uyumlu: AWS S3, Cloudflare R2, MinIO...)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_PUBLIC=""
STORAGE_BUCKET_PRIVATE=""
# Public dosyaların servis edildiği adres (CDN veya bucket public URL)
STORAGE_PUBLIC_BASE_URL=""

# Zamanlanmış işler (/api/cron/process-jobs): zamanlanmış e-postalar, haber yayını,
# otomatik raporlar. Zamanlayıcı "Authorization: Bearer <CRON_SECRET>" göndermelidir.
CRON_SECRET=""
# Sürekli çalışan sunucularda (npm start, Docker) aynı işler uygulama içinden 5 dakikada bir çalışır.
# off: kapatır · on: geliştirme ortamında da açar. Boş bırakılırsa yalnızca production'da çalışır.
INTERNAL_SCHEDULER=""

# AI dil modeli (opsiyonel). Yoksa AI Komuta Merkezi tanımlı Türkçe komutlarla çalışır.
# Yalnızca biri yeterlidir: OPENAI_API_KEY (OpenAI uyumlu) | ANTHROPIC_API_KEY | GEMINI_API_KEY
OPENAI_API_KEY=""
AI_BASE_URL=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_MS="20000"

# Dağıtık hız sınırlama (opsiyonel; yoksa bellek içi sınırlama kullanılır)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Microsoft 365 entegrasyonu (opsiyonel)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Meta / Instagram entegrasyonu (opsiyonel)
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_VERIFY_TOKEN=""
