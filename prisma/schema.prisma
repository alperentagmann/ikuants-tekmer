// ----------------------------------------------------------------------------
// V4 ENTERPRISE: ROOM & RESOURCE RESERVATION
// ----------------------------------------------------------------------------

model Resource {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique // e.g. ROOM-101, VR-LAB, CONF-HALL
  resourceType String        // MEETING_ROOM, TRAINING_HALL, VR_LAB, HARDWARE_EQUIPMENT, STUDIO
  capacity     Int           @default(10)
  location     String?       // e.g. 1. Kat / Blok A
  description  String?
  features     String?       // JSON e.g. ["Projector", "Teams Rooms", "Smart Board"]
  isActive     Boolean       @default(true)
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reservations Reservation[]

  @@index([resourceType])
  @@index([isActive])
}

model Reservation {
  id             String    @id @default(uuid())
  resourceId     String
  userId         String
  title          String
  startTime      DateTime
  endTime        DateTime
  status         String    @default("CONFIRMED") // CONFIRMED, PENDING_APPROVAL, CANCELLED, COMPLETED
  attendeeCount  Int       @default(1)
  attendeeNotes  String?
  agenda         String?
  meetingNotes   String?
  followUpTasks  String?   // JSON task summaries or IDs
  teamsMeetingUrl String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  resource       Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([userId])
  @@index([startTime, endTime])
  @@index([status])
}

// ----------------------------------------------------------------------------
// V4 ENTERPRISE: CONTRACTS & LEGAL AGREEMENT LIFECYCLE
// ----------------------------------------------------------------------------

model Contract {
  id                   String             @id @default(uuid())
  title                String
  contractNumber       String             @unique
  contractType         String             // INCUBATION_AGREEMENT, PROTOCOL, NDA, MENTORSHIP_MOU, VENDOR, LEASE
  partyA               String             @default("İKÜANTS TEKMER")
  partyB               String             // Company / Partner name
  partyBContactEmail   String?
  partyBContactPhone   String?
  status               String             @default("DRAFT") // DRAFT, IN_REVIEW, SIGNED, ACTIVE, EXPIRED, TERMINATED
  startDate            DateTime
  endDate              DateTime?
  autoRenew            Boolean            @default(false)
  renewalReminderDays  Int                @default(30)
  isRenewalAlertSent   Boolean            @default(false)
  responsibleUserId    String?
  sensitivityClass     String             @default("CONFIDENTIAL") // PUBLIC, INTERNAL, CONFIDENTIAL, STRICTLY_CONFIDENTIAL
  documentUrl          String?
  eSignStatus          String             @default("NOT_INITIATED") // NOT_INITIATED, PENDING_SIGNATURES, FULLY_SIGNED, REJECTED
