  emailTemplateKey String?
  conditionsJson   String? // JSON criteria
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([eventType])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: SECURITY EVENT CENTER
