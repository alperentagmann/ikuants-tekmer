  entrepreneur    Entrepreneur? @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  mentor          Mentor?       @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, accountType])
  @@index([accountType])
  @@index([entrepreneurId])
  @@index([mentorId])
}

// ----------------------------------------------------------------------------
// V4 ENTERPRISE: AUTOMATION RULES ENGINE
// ----------------------------------------------------------------------------

model AutomationRule {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  triggerType        String          // APPLICATION_SUBMITTED, TASK_OVERDUE, TRAINING_PUBLISHED, MEETING_COMPLETED, CONTRACT_EXPIRING, TASK_STATUS_CHANGED
  conditions         String?         // JSON DSL e.g. {"status": "NEW", "programType": "INCUBATION"}
  actions            String          // JSON array e.g. [{"action": "ASSIGN_TASK", "role": "application-manager"}, {"action": "SEND_NOTIFICATION"}]
  isActive           Boolean         @default(true)
  requireUserApproval Boolean        @default(false)
  executionCount     Int             @default(0)
  lastExecutedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  executionLogs      AutomationLog[]

  @@index([triggerType])
  @@index([isActive])
}

model AutomationLog {
  id           String         @id @default(uuid())
  ruleId       String
  triggerEvent String
  status       String         @default("SUCCESS") // SUCCESS, SKIPPED, FAILED, PENDING_APPROVAL
  payloadJson  String?        // Event payload
  actionResult String?        // Output of actions
  error        String?
  executedAt   DateTime       @default(now())

  rule         AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@index([executedAt])
}

// ----------------------------------------------------------------------------
// V4 ENTERPRISE: AI ASSISTANT & AUDIT LOGS
// ----------------------------------------------------------------------------

model AiTaskLog {
