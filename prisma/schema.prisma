model Redirect {
  id         String    @id @default(uuid())
  fromUrl    String    @unique
  toUrl      String
  statusCode Int       @default(301)
  isActive   Boolean   @default(true)
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
