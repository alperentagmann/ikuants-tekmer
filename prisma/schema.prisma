// ----------------------------------------------------------------------------
// V5 ENTERPRISE: NOTIFICATION RULES BUILDER
// ----------------------------------------------------------------------------

model NotificationRule {
  id               String   @id @default(uuid())
  name             String
  eventType        String   // APPLICATION_SUBMITTED, TASK_ASSIGNED, TASK_STATUS_CHANGED, CONTRACT_EXPIRING, MENTOR_ASSIGNED
  channels         String   @default("[\"IN_APP\",\"EMAIL\"]") // JSON array: IN_APP, EMAIL, TEAMS
  recipientGroup   String   // ASSIGNED_USER, PROGRAM_MANAGER, ALL_ADMINS, ROLE:slug, EMAIL:addr
  emailTemplateKey String?
  conditionsJson   String?  // JSON criteria
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

