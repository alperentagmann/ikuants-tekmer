model MeetingNote {
  id           String   @id @default(uuid())
  meetingId    String? // Link to CalendarEvent / TrainingSession if applicable
  title        String
  agenda       String?  @db.Text
  attendees    String? // JSON array of [{ name, email, role }]
  notes        String   @db.Text
