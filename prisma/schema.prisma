}

model EmailTemplate {
  id          String   @id @default(uuid())
  templateKey String   @unique // APPLICATION_RECEIVED, MISSING_DOCS, STATUS_UPDATE, MEETING_CONFIRMED, MENTOR_APPLIED, TASK_ASSIGNED, TRAINING_INVITE, EVENT_CONFIRMATION
  name        String
  subject     String
  htmlBody    String
  textBody    String?
  variables   String?  // JSON array e.g. ["name", "application_number", "program_name", "task_title"]
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id               String    @id @default(uuid())
  userId           String?   // null for all admins or specific user
  title            String
  message          String
  notificationType String    @default("INFO") // NEW_APPLICATION, NEW_CONTACT, MENTION, TASK_ASSIGNED, TASK_DUE, APPROVAL_REQUESTED, SYSTEM_ALERT
