  requesterEmail        String?
  requesterPhone        String?
  requesterOrganization String?
  purpose               String?
  personId              String?
  organizationId        String?
  submissionId          String?
  decisionNote          String?
  alternativeJson       String? // JSON: suggested alternative space/time
