  dueDate           DateTime?
  dueTime           String? // e.g. "14:30"
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category          String    @default("GENERAL") // GENERAL, MEETING, FOLLOW_UP, REVIEW, CALL
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  reminderDate      DateTime?
  reminderChannel   String?   @default("IN_APP") // IN_APP, EMAIL, TEAMS
  relatedEntityType String? // Entrepreneur, Mentor, Project, Application, Task
  relatedEntityId   String?
  convertedTaskId   String?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklistJson    String? // JSON [{ title, done }]
  recurrence       String? // DAILY, WEEKDAYS, WEEKLY, MONTHLY
  estimatedMinutes Int?
  tags             String? // comma separated
  timeEntries      TaskTimeEntry[]

  @@index([userId])
  @@index([isCompleted])
  @@index([dueDate])
