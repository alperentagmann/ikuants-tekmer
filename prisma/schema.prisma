// ----------------------------------------------------------------------------
// V5 ENTERPRISE: CUSTOMIZABLE TERMINOLOGY & LABELS
// ----------------------------------------------------------------------------

model TerminologyLabel {
  id           String   @id @default(uuid())
  key          String   @unique // e.g. "tasks.title", "tasks.status.done", "entrepreneurs.title"
  group        String   @default("GENERAL") // MODULES, STATUSES, BUTTONS, MESSAGES
  defaultLabel String
  customLabel  String?
  description  String?
  updatedAt    DateTime @updatedAt

  @@index([group])
