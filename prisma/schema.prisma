  generatedOutput  String
  status           String    @default("GENERATED") // GENERATED, ACCEPTED, REJECTED, EDITED
  approvedByUserId String?
  approvedAt       DateTime?
  metadata         String?   // JSON
  createdAt        DateTime  @default(now())

  approvedByUser   User?     @relation(fields: [approvedByUserId], references: [id])

  @@index([taskType])
  @@index([status])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: MULTI-ADMIN INVITES & CREDENTIALS LIFECYCLE
// ----------------------------------------------------------------------------

model UserInvite {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  title        String?
  department   String?
  tokenHash    String    @unique
  roleId       String
