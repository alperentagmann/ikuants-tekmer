  @@index([isRead])
  @@index([createdAt])
}

model SystemErrorLog {
  id         String   @id @default(uuid())
  errorCode  String?
  route      String?
  requestId  String?
  userId     String?
  severity   String   @default("ERROR") // INFO, WARN, ERROR, CRITICAL
  message    String
  stackTrace String?
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// V4 ENTERPRISE: MICROSOFT 365 & INTEGRATION HUB
