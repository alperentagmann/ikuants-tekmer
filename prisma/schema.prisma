  @@index([userId])
  @@index([tokenHash])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: CUSTOMIZABLE TERMINOLOGY & LABELS
// ----------------------------------------------------------------------------

model TerminologyLabel {
  id           String    @id @default(uuid())
  key          String    @unique // e.g. "tasks.title", "tasks.status.done", "entrepreneurs.title"
  group        String    @default("GENERAL") // MODULES, STATUSES, BUTTONS, MESSAGES
  defaultLabel String
  customLabel  String?
  description  String?
  updatedAt    DateTime  @updatedAt

  @@index([group])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: MODULE CUSTOM FIELDS & EXTENSIBILITY
// ----------------------------------------------------------------------------

model CustomFieldDefinition {
  id             String             @id @default(uuid())
  moduleKey      String             // ENTREPRENEUR, MENTOR, TASK, ACTIVITY, APPLICATION, PROJECT
  fieldKey       String             // e.g. "is_exporting", "trl_level", "annual_revenue"
  label          String
  fieldType      String             @default("TEXT") // TEXT, TEXTAREA, NUMBER, CURRENCY, DATE, DATETIME, BOOLEAN, SELECT, MULTI_SELECT, USER, ORGANIZATION, URL, EMAIL, PHONE, FILE
  placeholder    String?
  description    String?
  isRequired     Boolean            @default(false)
  defaultValue   String?
  optionsJson    String?            // JSON array for SELECT / MULTI_SELECT
  viewPermission String?            // Specific permission or null for all
  editPermission String?            // Specific permission or null for all
  isPublic       Boolean            @default(false)
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  values         CustomFieldValue[]

  @@unique([moduleKey, fieldKey])
  @@index([moduleKey])
}

model CustomFieldValue {
  id           String                @id @default(uuid())
  definitionId String
  entityId     String                // ID of the target record (e.g. Entrepreneur.id)
  textValue    String?
  numValue     Float?
  dateValue    DateTime?
  jsonValue    String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([entityId])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: CUSTOM STATUS & PIPELINES
// ----------------------------------------------------------------------------

model PipelineStatus {
  id                 String   @id @default(uuid())
  moduleKey          String   // APPLICATION, TASK, PROJECT, ACTIVITY
  statusKey          String   // e.g. "NEW", "PRE_REVIEW", "TODO", "IN_PROGRESS"
  displayLabel       String
  colorCode          String   @default("#6366f1")
  sortOrder          Int      @default(0)
  isInitial          Boolean  @default(false)
  isTerminal         Boolean  @default(false)
  isActive           Boolean  @default(true)
  allowedTransitions String?  // JSON array of target statusKeys
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([moduleKey, statusKey])
  @@index([moduleKey])
}

// ----------------------------------------------------------------------------
// V5 ENTERPRISE: EMAIL OUTBOX & DELIVERY ENGINE
// ----------------------------------------------------------------------------

model EmailOutbox {
  id                 String    @id @default(uuid())
  recipientEmail     String
  recipientName      String?
  subject            String
  templateKey        String?
  htmlBody           String
  textBody           String?
  status             String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED, CANCELLED
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  nextRetryAt        DateTime?
  sentAt             DateTime?
  providerMessageId  String?
  errorMessage       String?
  entityType         String?   // APPLICATION, TASK, INVITE, PASSWORD_RESET, SECURITY_ALERT
  entityId           String?
  metadata           String?   // JSON
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

