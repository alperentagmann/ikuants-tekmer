// ----------------------------------------------------------------------------
// ENTERPRISE: MERKEZİ RAPORLAMA & MANAGEMENT INTELLIGENCE CENTER
// ----------------------------------------------------------------------------

model OperationalReport {
  id               String    @id @default(uuid())
  title            String
  slug             String    @unique
  reportType       String // DAILY, MONTHLY, TEAM, YEARLY, SOCIAL, CROSS_CHANNEL, CUSTOM
  periodStart      DateTime
  periodEnd        DateTime
  authorId         String? // null for system-generated (automatic) reports
  department       String?
  status           String    @default("DRAFT") // AUTO_GENERATED_DRAFT, DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED
  executiveSummary String?   @db.Text
  aiDraftSummary   String?   @db.Text
  contentJson      String?   @db.Text // Modular report blocks and text sections
  metricsJson      String?   @db.Text // Computed facts and KPIs from live database
  chartsConfigJson String?   @db.Text // Charts and visualization configuration
  approvedById     String?
  approvedAt       DateTime?
  version          Int       @default(1)
  isScheduled      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author     User? @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  periodKey       String? // e.g. DAILY:2026-10-01, MONTHLY:2026-09, YEARLY:2025
  isAutoGenerated Boolean @default(false)
  isOutdated      Boolean @default(false)
  supersedesId    String? // Previous version this report replaces

  @@index([reportType, periodKey])
  @@index([reportType])
  @@index([status])
  @@index([authorId])
  @@index([periodStart, periodEnd])
}

model ReportTemplate {
  id                 String   @id @default(uuid())
  key                String   @unique
  title              String
  description        String?
  category           String   @default("GENERAL") // DAILY, MONTHLY, YEARLY, PROGRAM, EVENT, MENTORSHIP, SOCIAL, PROJECT
  defaultLayoutJson  String?  @db.Text
  defaultMetricsJson String?  @db.Text
  isSystem           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
