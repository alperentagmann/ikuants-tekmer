  eventType    String // FAILED_LOGIN, LOCKED_ACCOUNT, MFA_DISABLED, SUSPICIOUS_IP, MASS_EXPORT, PII_BULK_ACCESS, SUPER_ADMIN_MODIFIED, SESSION_REVOKED
