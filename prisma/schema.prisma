// ----------------------------------------------------------------------------
// ENTERPRISE: SOCIAL MEDIA INTEGRATION CENTER (INSTAGRAM, LINKEDIN, ETC.)
// ----------------------------------------------------------------------------

model SocialAccount {
  id                    String    @id @default(uuid())
  provider              String    @default("INSTAGRAM") // INSTAGRAM, LINKEDIN, YOUTUBE, FACEBOOK
  accountName           String
  accountId             String    @unique
  profileUrl            String?
  avatarUrl             String?
  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  tokenExpiresAt        DateTime?
  isActive              Boolean   @default(true)
  syncIntervalMinutes   Int       @default(30)
  syncMode              String    @default("AUTO_DRAFT") // MANUAL_REVIEW, AUTO_DRAFT, AUTO_PUBLISH
  lastSyncAt            DateTime?
  webhookSecret         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  posts       SocialPost[]
  syncRuns    SocialSyncRun[]
  importRules SocialImportRule[]

  @@index([provider])
  @@index([isActive])
}

model SocialPost {
  id               String   @id @default(uuid())
  socialAccountId  String
  externalId       String // Instagram Media ID (Unique per post)
  caption          String?  @db.Text
  mediaType        String   @default("IMAGE") // IMAGE, VIDEO, CAROUSEL_ALBUM
  mediaUrl         String?  @db.Text
  thumbnailUrl     String?  @db.Text
  permalink        String?  @db.Text
  postDate         DateTime
  syncStatus       String   @default("NEW") // NEW, IMPORTED, DRAFT_CREATED, PUBLISHED, IGNORED, FAILED, SOURCE_REMOVED
  convertedNewsId  String?
  convertedEventId String?
  rawDataJson      String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  socialAccount SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  contentLinks  SocialContentLink[]

  @@unique([socialAccountId, externalId])
  @@index([syncStatus])
  @@index([postDate])
}

model SocialImportRule {
  id                String   @id @default(uuid())
  socialAccountId   String
  keywordOrHashtag  String // e.g. #duyuru, #haber, #etkinlik
  targetContentType String   @default("NEWS") // NEWS, ANNOUNCEMENT, EVENT
  targetCategory    String?
  autoPublish       Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
}

model SocialSyncRun {
  id              String    @id @default(uuid())
  socialAccountId String
  status          String    @default("RUNNING") // RUNNING, SUCCESS, PARTIAL, FAILED
  postsFound      Int       @default(0)
  postsImported   Int       @default(0)
  postsDrafted    Int       @default(0)
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId])
}

model SocialContentLink {
  id           String   @id @default(uuid())
  socialPostId String
  entityType   String // News, Event, Announcement
  entityId     String
  source       String   @default("INSTAGRAM")
  createdAt    DateTime @default(now())

  socialPost SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([socialPostId])
  @@index([entityType, entityId])
}

