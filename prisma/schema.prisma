model ReportSchedule {
  id             String    @id @default(uuid())
  title          String
  reportType     String    @default("DAILY") // DAILY, WEEKLY, MONTHLY, YEARLY
  frequency      String // DAILY_1800, WEEKLY_MON, MONTHLY_1ST, YEARLY_JAN1
  cronExpression String?
  targetRole     String?
  recipientsJson String // JSON array of recipient emails
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

// ----------------------------------------------------------------------------
// OPERATIONS SUITE: DAILY INTERACTIONS, PROGRAM ASSIGNMENTS & KVKK
// ----------------------------------------------------------------------------

model DailyInteraction {
  id               String    @id @default(uuid())
  date             DateTime  @default(now())
  startTime        String? // e.g. "10:30"
  endTime          String? // e.g. "11:30"
  interactionType  String    @default("MEETING") // VISIT, IN_PERSON, ONLINE, PHONE, MENTOR_SESSION, ENTREPRENEUR_MEETING, INVESTOR_MEETING, PARTNERSHIP, OTHER
  contactName      String // Gelen/Görüşülen kişi
  organizationName String? // Firma / Kurum
  phone            String?
  email            String?
  hostUserId       String? // Görüşmeyi gerçekleştiren kullanıcı / personel
  otherAttendees   String? // Diğer katılımcılar
  subject          String // Görüşme konusu
  notes            String?   @db.Text // Toplantı / görüşme notu
  decisions        String?   @db.Text // Alınan kararlar
  nextSteps        String?   @db.Text // Sonraki adımlar
  followUpDate     DateTime? // Takip tarihi
  status           String    @default("COMPLETED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, FOLLOW_UP_NEEDED
  tags             String? // JSON array of strings
  attachments      String? // JSON array of { name, url, size }

  // Polymorphic / Relational Links
  entrepreneurId    String?
  mentorId          String?
  programId         String?
  applicationId     String?
  projectId         String?
  eventId           String?
  createdTaskId     String? // Link if converted to task
  createdActivityId String? // Link if converted to activity
  hasKvkkConsent    Boolean @default(false)
  kvkkConsentId     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostUser     User?         @relation("InteractionHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  entrepreneur Entrepreneur? @relation(fields: [entrepreneurId], references: [id], onDelete: SetNull)
  mentor       Mentor?       @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  program      Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kvkkConsent  KvkkConsent?  @relation(fields: [kvkkConsentId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([interactionType])
  @@index([status])
  @@index([hostUserId])
  @@index([entrepreneurId])
  @@index([followUpDate])
}

model EntrepreneurProgram {
  id             String    @id @default(uuid())
  entrepreneurId String
  programId      String? // null for tracks that are not a Program (TEKMER yer edinme, other)
  programLabel   String? // display name when programId is null: "TEKMER Yer Edinme" or free text
  cohort         String? // e.g. "2026-Q3", "1. Dönem"
  status         String    @default("ACTIVE") // ASSIGNED, APPLIED, ACCEPTED, ACTIVE, COMPLETED, WITHDRAWN, REJECTED
  joinedAt       DateTime  @default(now())
  completedAt    DateTime?
  leftAt         DateTime?
  notes          String?   @db.Text
  assignedById   String?
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entrepreneur Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Restrict)
  program      Program?     @relation(fields: [programId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("ProgramAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([entrepreneurId])
  @@index([programId])
  @@index([status])
}

model KvkkTextVersion {
  id           String   @id @default(uuid())
  title        String // e.g. "İKÜANTS TEKMER Aydınlatma ve Açık Rıza Metni"
  version      String // e.g. "v1.0", "v2.0"
  content      String   @db.Text
  summary      String?  @db.Text
  consentTypes String // JSON array of ["DATA_PROCESSING", "MARKETING_COMMUNICATION", "PHOTO_VIDEO_USE", "ABROAD_TRANSFER"]
  isPublished  Boolean  @default(true)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  consents KvkkConsent[]

  @@unique([title, version])
}

model KvkkConsent {
  id                 String  @id @default(uuid())
  subjectType        String // APPLICANT, ENTREPRENEUR, FOUNDER, MENTOR, INSTRUCTOR, EVENT_ATTENDEE, VISITOR, STAKEHOLDER, OTHER
  fullName           String
  email              String?
  phone              String?
  tcNumberMasked     String?
  organizationName   String?
  sourceChannel      String  @default("FORM") // FORM, APPLICATION, EVENT, IN_PERSON_VISIT, MANUAL, CONTRACT
  sourceFormId       String?
  sourceSubmissionId String?

  textVersionId      String?
  isExplicitConsent  Boolean @default(true)
  allowCommunication Boolean @default(false)
  allowMediaUse      Boolean @default(false)
  allowMarketing     Boolean @default(false)

  status              String    @default("ACTIVE") // ACTIVE, WITHDRAWN, EXPIRED, SUPERSEDED, NEEDS_REVIEW
  consentedAt         DateTime  @default(now())
  withdrawnAt         DateTime?
  evidenceDocumentUrl String?
  notes               String?   @db.Text

  // Relations
  entrepreneurId String?
  mentorId       String?
  applicationId  String?
  userId         String?
  personId       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  textVersion       KvkkTextVersion?   @relation(fields: [textVersionId], references: [id], onDelete: SetNull)
  entrepreneur      Entrepreneur?      @relation(fields: [entrepreneurId], references: [id], onDelete: SetNull)
  mentor            Mentor?            @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  person            Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  dailyInteractions DailyInteraction[]

  @@index([subjectType])
  @@index([status])
  @@index([email])
  @@index([consentedAt])
}

// ----------------------------------------------------------------------------
// FINANCE, PROJECT BUDGET, EXPENSE & INVOICES
// ----------------------------------------------------------------------------

model FundingSource {
  id                String    @id @default(uuid())
  projectId         String
  organizationName  String // TÜBİTAK, KOSGEB, İSTKA, AB, Üniversite, Sponsor, Yatırımcı, Özel Şirket, vb.
  programGrantName  String // e.g. "KOSGEB TEKMER Destek Programı"
  awardedAmount     Float
  currency          String    @default("TRY") // TRY, USD, EUR, GBP
  agreementNo       String?
  agreementDate     DateTime?
  expectedStartDate DateTime?
  expectedEndDate   DateTime?
  description       String?   @db.Text
  documentUrl       String?
  status            String    @default("ACTIVE") // ACTIVE, COMPLETED, SUSPENDED, CANCELLED
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  receipts FundingReceipt[]
  expenses ProjectExpense[]

  @@index([projectId])
  @@index([status])
}

model FundingReceipt {
  id              String    @id @default(uuid())
  fundingSourceId String
  installmentNo   String? // "1. Dilim", "2. Dilim", "Hakediş 1"
  amount          Float
  currency        String    @default("TRY")
  expectedDate    DateTime
  receivedDate    DateTime?
  status          String    @default("EXPECTED") // EXPECTED, RECEIVED, PARTIALLY_RECEIVED, DELAYED, CANCELLED
  bankReferenceNo String?
  description     String?
  receiptDocUrl   String?
  receivedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fundingSource FundingSource @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)

  @@index([fundingSourceId])
  @@index([status])
  @@index([expectedDate])
}

model ProjectBudgetLine {
  id              String   @id @default(uuid())
  projectId       String
  code            String? // e.g. "1.1", "2.1"
  title           String // e.g. "Personel Giderleri", "Yazılım & Lisans", "Danışmanlık", "Eğitim"
  category        String   @default("PERSONNEL") // PERSONNEL, SOFTWARE, HARDWARE, TRAINING, EVENT, CONSULTING, TRAVEL, ACCOMMODATION, OFFICE, SUPPLIES, SERVICE_PURCHASE, OTHER
  allocatedAmount Float
  currency        String   @default("TRY")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses ProjectExpense[]

  @@index([projectId])
}

model ProjectExpense {
  id              String   @id @default(uuid())
  projectId       String
  fundingSourceId String?
  budgetLineId    String?
  expenseDate     DateTime @default(now())
  category        String   @default("OTHER") // PERSONNEL, TRAINING, EVENT, CONSULTING, SOFTWARE, HARDWARE, TRAVEL, ACCOMMODATION, ORGANIZATION, PROMOTION, OFFICE, SUPPLIES, SERVICE_PURCHASE, OTHER
  supplierVendor  String // Satıcı / Tedarikçi Firma veya Kişi
  description     String
  amount          Float // Net Tutar
  vatAmount       Float    @default(0) // KDV
  totalAmount     Float // Toplam Tutar (Net + KDV)
  currency        String   @default("TRY")

  paymentStatus String    @default("PENDING") // DRAFT, SUBMITTED, APPROVED, REJECTED, PENDING, PAID, CANCELLED
  paymentDate   DateTime?
  paymentMethod String? // BANK_TRANSFER, CREDIT_CARD, CASH, EFT

  invoiceNumber String?
  invoiceDate   DateTime?
  invoiceDocUrl String?
  receiptDocUrl String?

  relatedActivityId String?
  relatedTaskId     String?
  notes             String? @db.Text

  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  fundingSource FundingSource?     @relation(fields: [fundingSourceId], references: [id], onDelete: SetNull)
  budgetLine    ProjectBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  invoices      InvoiceRecord[]

  @@index([projectId])
  @@index([fundingSourceId])
  @@index([budgetLineId])
  @@index([paymentStatus])
  @@index([expenseDate])
}

model InvoiceRecord {
  id             String    @id @default(uuid())
  expenseId      String?
  projectId      String?
  entrepreneurId String?
  vendorName     String
  invoiceNumber  String
  invoiceDate    DateTime
  netAmount      Float
  taxVatAmount   Float     @default(0)
  grossAmount    Float
  currency       String    @default("TRY")
  status         String    @default("RECORDED") // RECORDED, APPROVED, PAID, CANCELLED
  paymentDate    DateTime?
  documentUrl    String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  expense      ProjectExpense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  entrepreneur Entrepreneur?   @relation(fields: [entrepreneurId], references: [id], onDelete: SetNull)

  @@index([vendorName, invoiceNumber])
  @@index([projectId])
  @@index([entrepreneurId])
}

// ----------------------------------------------------------------------------
// RENT CONTRACT, ACCRUAL, PARTIAL PAYMENT & REMINDERS
// ----------------------------------------------------------------------------

model RentContract {
  id              String   @id @default(uuid())
  entrepreneurId  String
  spaceFacilityId String? // Facility / Room / Desk ID
  spaceName       String // e.g. "Ofis 204", "Ortak Çalışma Masası 12"
  roomDeskNo      String? // e.g. "Masa 4", "Oda 204"
  areaM2          Float? // e.g. 24.5 m²
  spaceType       String   @default("OFFICE") // OFFICE, SHARED_DESK, LAB, WORKSHOP, VIRTUAL
  contractNo      String   @unique
  contractDate    DateTime @default(now())
  startDate       DateTime
  endDate         DateTime

  // Şirket & İletişim Snapshot & Relational Links
  organizationId         String?
  financeContactPersonId String?
  commercialTitle        String? // Şirket Ticari Unvanı
  contactPersonName      String? // Finans / Kira İletişim Yetkilisi
  contactEmail           String?
  contactPhone           String?

  // Finansal Bilgiler
  monthlyRent      Float // Aylık Net Kira
  currency         String @default("TRY")
  vatRate          Float  @default(20) // %20 KDV
  vatAmount        Float  @default(0)
  totalMonthlyRent Float  @default(0) // Net + KDV
  dueDay           Int    @default(5) // Her ayın 5. günü
  depositAmount    Float  @default(0)

  // Muafiyet & Ücretsiz Dönem
  isWaived        Boolean   @default(false) // Kira Muaf
  freePeriodStart DateTime?
  freePeriodEnd   DateTime?
  waiverReason    String?

  // Yenileme
  autoRenew         Boolean @default(false)
  renewalNoticeDays Int     @default(30)

  status         String  @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED, SUSPENDED, WAIVED
  contractDocUrl String?
  notes          String? @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entrepreneur         Entrepreneur           @relation(fields: [entrepreneurId], references: [id], onDelete: Restrict)
  organization         Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  financeContactPerson Person?                @relation("RentFinanceContact", fields: [financeContactPersonId], references: [id], onDelete: SetNull)
  facility             Facility?              @relation(fields: [spaceFacilityId], references: [id], onDelete: SetNull)
  accruals             RentAccrual[]
  documents            RentContractDocument[]

  tasks            Task[]
  spaceAssignments SpaceAssignment[]

  @@index([entrepreneurId])
  @@index([organizationId])
  @@index([financeContactPersonId])
  @@index([status])
}

model RentContractDocument {
  id           String   @id @default(uuid())
  contractId   String
  documentType String   @default("SIGNED_CONTRACT") // SIGNED_CONTRACT, ADDITIONAL_PROTOCOL, AMENDMENT, DELIVERY_REPORT, DEPOSIT_RECEIPT, TERMINATION_EVICTION, OTHER
  title        String
  fileUrl      String
  documentDate DateTime @default(now())
  description  String?  @db.Text
  version      Int      @default(1)
  uploadedById String?
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contract RentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([documentType])
}

model RentAccrual {
  id              String @id @default(uuid())
  contractId      String
  entrepreneurId  String
  year            Int // 2026
  month           Int // 1-12
  periodLabel     String // "Eylül 2026"
  baseAmount      Float // Aylık net kira
  vatAmount       Float // KDV tutarı
  totalDue        Float // Tahakkuk eden toplam tutar
  paidAmount      Float  @default(0) // Toplam ödenen
  remainingAmount Float // Kalan borç
  currency        String @default("TRY")

  dueDate            DateTime // Son ödeme tarihi (örn 05.09.2026)
  status             String    @default("UPCOMING") // UPCOMING, DUE, PARTIALLY_PAID, PAID, OVERDUE, WAIVED, CANCELLED
  daysOverdue        Int       @default(0)
  lastReminderSentAt DateTime?
  reminderCount      Int       @default(0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract     RentContract  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  entrepreneur Entrepreneur  @relation(fields: [entrepreneurId], references: [id], onDelete: Restrict)
  payments     RentPayment[]

  @@unique([contractId, year, month])
  @@index([entrepreneurId])
  @@index([status])
  @@index([dueDate])
  @@index([year, month])
}

model RentPayment {
  id             String   @id @default(uuid())
  accrualId      String
  entrepreneurId String
  amount         Float
  currency       String   @default("TRY")
  paymentDate    DateTime @default(now())
  paymentMethod  String   @default("BANK_TRANSFER") // BANK_TRANSFER, EFT, CREDIT_CARD, CASH
  bankReceiptNo  String?
  receiptDocUrl  String?
  description    String?
  receivedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accrual      RentAccrual  @relation(fields: [accrualId], references: [id], onDelete: Restrict)
  entrepreneur Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Restrict)

  @@index([accrualId])
  @@index([entrepreneurId])
  @@index([paymentDate])
}

model RentReminderRule {
  id                String   @id @default(uuid())
  ruleName          String // e.g. "Vadeden 3 gün önce", "Vade Günü", "3 Gün Gecikme", "7 Gün Gecikme"
  daysOffset        Int // -3: 3 gün önce, 0: vade günü, 3: 3 gün sonra, 7: 7 gün sonra
  triggerType       String // BEFORE_DUE, ON_DUE, OVERDUE
  emailSubject      String
  emailTemplateBody String   @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// GENERIC RECEIVABLES & MULTI-CURRENCY CONVERSION
// ----------------------------------------------------------------------------

model Receivable {
  id          String   @id @default(uuid())
  debtor      String // Borçlu Kişi / Kurum / Girişim
  source      String   @default("OTHER") // RENT, PROJECT_PAYMENT, SERVICE_FEE, SPONSORSHIP, EVENT, OTHER
  description String?  @db.Text
  amount      Float // Toplam Alacak Tutarı
  currency    String   @default("TRY") // TRY, USD, EUR, GBP
  dueDate     DateTime // Vade Tarihi
  paid        Float    @default(0) // Tahsil Edilen Tutar
  remaining   Float // Kalan Alacak (amount - paid)
  status      String   @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, WRITTEN_OFF

  // Multi-currency tracking
  exchangeRate       Float? // e.g. 38.5
  exchangeRateDate   DateTime?
  sourceCurrency     String? // e.g. USD
  targetCurrency     String? // e.g. TRY
  baseCurrencyAmount Float? // Base currency equivalent if exchangeRate is known

  invoiceNumber String?
  paymentDate   DateTime?
  paymentMethod String? // BANK_TRANSFER, EFT, CREDIT_CARD, CASH
  bankReceiptNo String?
  documentUrl   String?
  notes         String?   @db.Text

  // Relational links
  relatedProjectId      String?
  relatedEntrepreneurId String?
  relatedOrganizationId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  relatedProject      Project?      @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  relatedEntrepreneur Entrepreneur? @relation(fields: [relatedEntrepreneurId], references: [id], onDelete: SetNull)
  relatedOrganization Organization? @relation(fields: [relatedOrganizationId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([status])
  @@index([dueDate])
  @@index([currency])
  @@index([relatedProjectId])
  @@index([relatedEntrepreneurId])
  @@index([relatedOrganizationId])
}

model ExchangeRate {
  id             String   @id @default(uuid())
  sourceCurrency String // USD, EUR, GBP, TRY
  targetCurrency String   @default("TRY") // TRY
  rate           Float // 1 USD = 38.5 TRY
  rateDate       DateTime @default(now())
  source         String?  @default("MANUAL") // TCMB, MANUAL, SYSTEM
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceCurrency, targetCurrency, rateDate])
  @@index([sourceCurrency, targetCurrency])
}

// ----------------------------------------------------------------------------
// UNIFIED MASTER CRM & CENTRAL DIRECTORY (PERSON & RELATIONSHIPS)
// ----------------------------------------------------------------------------

model Person {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  fullName          String
  title             String? // e.g. "Kurucu Ortak", "Kıdemli Yazılım Mimarı", "Finans Direktörü"
  salutation        String? // e.g. "Prof. Dr.", "Dr.", "Av.", "Sayın"
  email             String?   @unique
  workEmail         String?
  personalEmail     String?
  primaryEmailType  String?   @default("WORK") // WORK, PERSONAL
  secondaryEmail    String?
  phone             String?
  workPhone         String?
  extension         String? // Dahili
  secondaryPhone    String?
  linkedin          String?
  websiteUrl        String?
  avatarUrl         String?
  birthDate         DateTime?
  nationality       String?   @default("TC")
  isTurkishCitizen  Boolean   @default(true)
  tcNumberMasked    String? // e.g. "12*******90"
  tcNumberEncrypted String?   @db.Text // AES-256-GCM encrypted
  tcNumberHash      String? // Deterministic HMAC for duplicate check
  city              String?
  state             String? // İlçe
  country           String?   @default("Türkiye")
  address           String?   @db.Text
  postalCode        String?
  notes             String?   @db.Text
  tags              String? // JSON array of strings
  businessRoles     String? // JSON array of strings: ["KURUCU", "SIRKET_PERSONELI", "MENTOR", "EGITMEN", "AKADEMISYEN", "YATIRIMCI", "PAYDAS", "PROGRAM_KATILIMCISI", "FIRMA_TEMSILCISI", "FINANS_YETKILISI", "HUKUK_YETKILISI", "DIGER"]
  dataSource        String?   @default("MANUAL_ADMIN") // MANUAL_ADMIN, PUBLIC_APPLICATION, PROGRAM_APPLICATION, RESERVATION, EVENT, IMPORT, REFERRAL, OTHER
  privacyConsents   String?   @db.Text // JSON with full KVKK consent history and status
  status            String    @default("ACTIVE") // ACTIVE, PASSIVE, ARCHIVED
  userId            String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                  User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships           PersonOrganizationMembership[]
  founders              EntrepreneurFounder[]
  mentors               Mentor[]
  stakeholders          StakeholderRelationship[]
  assignedRentContracts RentContract[]                 @relation("RentFinanceContact")
  kvkkConsents          KvkkConsent[]

  applications Application[]
  submissions  Submission[]
  reservations Reservation[]
  tasks        Task[]

  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@index([tcNumberHash])
  @@index([status])
}

model PersonOrganizationMembership {
  id                    String    @id @default(uuid())
  personId              String
  organizationId        String
  role                  String    @default("EMPLOYEE") // FOUNDER, CO_FOUNDER, CEO, CTO, EMPLOYEE, FINANCE_CONTACT, LEGAL_CONTACT, AUTHORIZED_PERSON, OTHER
  department            String?
  position              String?
  startDate             DateTime? @default(now())
  endDate               DateTime?
  isPrimaryContact      Boolean   @default(false)
  isFinanceContact      Boolean   @default(false)
  isLegalContact        Boolean   @default(false)
  isAuthorizedSignatory Boolean   @default(false)
  employmentType        String? // FULL_TIME, PART_TIME, INTERN, CONSULTANT, CONTRACT, VOLUNTEER
  sgkStatus             String? // SGK status as a definition, e.g. "Stajyer — iş kazası ve meslek hastalığı sigortası"
  isRdStaff             Boolean   @default(false) // Ar-Ge / tasarım personeli (5746)
  status                String    @default("ACTIVE") // ACTIVE, FORMER, LEAVE
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([organizationId])
  @@index([role])
  @@index([status])
}

model EntrepreneurOrganization {
  id             String    @id @default(uuid())
  entrepreneurId String
  organizationId String
  relationType   String    @default("PRIMARY") // PRIMARY, SUBSIDIARY, SPIN_OFF, HOLDING
  isPrimary      Boolean   @default(true)
  startDate      DateTime? @default(now())
  endDate        DateTime?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  entrepreneur Entrepreneur @relation(fields: [entrepreneurId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([entrepreneurId, organizationId])
  @@index([entrepreneurId])
  @@index([organizationId])
}

model StakeholderRelationship {
  id                 String    @id @default(uuid())
  entityType         String    @default("ORGANIZATION") // PERSON, ORGANIZATION
  personId           String?
  organizationId     String?
  stakeholderType    String    @default("COLLABORATION_PARTNER") // COLLABORATION_PARTNER, INVESTOR_PARTNER, ACADEMIC_PARTNER, PUBLIC_AGENCY, SUPPLIER, SPONSOR, OTHER
  relationshipStatus String    @default("ACTIVE") // ACTIVE, POTENTIAL, FORMER, SUSPENDED
  ownerUserId        String?
  startedAt          DateTime? @default(now())
  endedAt            DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([entityType])
  @@index([personId])
  @@index([organizationId])
  @@index([stakeholderType])
}

// ----------------------------------------------------------------------------
// AI OPERATIONS LAYER (COPILOT, DOMAIN ACTIONS & REVERSIBLE CHANGESETS)
// ----------------------------------------------------------------------------

model AiChangeSet {
  id             String    @id @default(uuid())
  userId         String
  userEmail      String?
  userName       String?
  requestPrompt  String    @db.Text
  intent         String // e.g. "cms.banner.create", "user.invite", "report.daily", "rent.payment"
  riskLevel      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  actionsJson    String    @db.Text // JSON array of performed actions
  beforeState    String?   @db.Text // JSON snapshot before mutation
  afterState     String?   @db.Text // JSON snapshot after mutation
  summary        String?   @db.Text
  status         String    @default("COMPLETED") // DRAFT, PENDING_CONFIRMATION, EXECUTING, COMPLETED, FAILED, ROLLED_BACK
  rollbackStatus String? // NOT_ROLLED_BACK, ROLLED_BACK, ROLLBACK_FAILED
  rollbackError  String?   @db.Text
  executedAt     DateTime  @default(now())
  rolledBackAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([intent])
  @@index([status])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// APPLICATION CAMPAIGNS (Program / TEKMER / other application processes)
// Each campaign owns its form, workflow, evaluation, documents and e-mail mapping.
// ----------------------------------------------------------------------------

model ApplicationCampaign {
  id                      String    @id @default(uuid())
  name                    String
  slug                    String    @unique
  applicationType         String // PROGRAM, TEKMER, IDEATHON, HACKATHON, EVENT, TRAINING, MENTOR, ENTREPRENEUR, OTHER
  description             String?   @db.Text
  status                  String    @default("DRAFT") // DRAFT, OPEN, CLOSED, ARCHIVED
  programId               String?
  formId                  String?
  evaluationTemplateId    String?
  ownerId                 String?
  opensAt                 DateTime?
  closesAt                DateTime?
  publicPath              String? // Public page that renders this campaign's form
  allowedApplicantTypes   String? // JSON array: PERSON, ENTREPRENEUR, ORGANIZATION, TEAM
  workflowStages          String?   @db.Text // JSON array [{ key, label, order, isTerminal, outcome }]
  requiredDocuments       String?   @db.Text // JSON array [{ key, label, required, allowedTypes, maxSizeMb, description, requiredAtStage }]
  notificationRecipients  String? // JSON array of internal e-mail recipients
  confirmationTemplateKey String? // EmailTemplate.templateKey sent on submission
  statusTemplateMap       String?   @db.Text // JSON { [status]: templateKey }
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  program            Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  form               Form?               @relation(fields: [formId], references: [id], onDelete: SetNull)
  evaluationTemplate EvaluationTemplate? @relation(fields: [evaluationTemplateId], references: [id], onDelete: SetNull)
  owner              User?               @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  applications       Application[]
  submissions        Submission[]

  @@index([applicationType])
  @@index([status])
  @@index([programId])
}

// ----------------------------------------------------------------------------
// SPACE ASSIGNMENT (long-term allocation of a Facility; distinct from Reservation)
// ----------------------------------------------------------------------------

model SpaceAssignment {
  id             String    @id @default(uuid())
  facilityId     String
  entrepreneurId String?
  organizationId String?
  applicationId  String? // TEKMER application that started the process
  rentContractId String?
  status         String    @default("PLANNED") // PLANNED, ACTIVE, ENDED, CANCELLED
  unitLabel      String? // Desk / room label inside the facility
  startDate      DateTime?
  endDate        DateTime?
  notes          String?   @db.Text
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  entrepreneur Entrepreneur? @relation(fields: [entrepreneurId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  rentContract RentContract? @relation(fields: [rentContractId], references: [id], onDelete: SetNull)

  @@index([facilityId])
  @@index([entrepreneurId])
  @@index([organizationId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// 3D / 360 FACILITY EXPERIENCE (optional; only real assets uploaded by admins)
// ----------------------------------------------------------------------------

model FacilityExperience {
  id              String   @id @default(uuid())
  facilityId      String   @unique
  isEnabled       Boolean  @default(false)
  isPublic        Boolean  @default(false)
  mode            String   @default("MODEL") // MODEL (GLB/glTF) or PANORAMA (360 image)
  modelUrl        String?
  modelMediaId    String?
  panoramaUrl     String?
  panoramaMediaId String?
  posterUrl       String?
  posterMediaId   String?
  altText         String?
  description     String?  @db.Text
  cameraOrbit     String? // model-viewer camera-orbit, e.g. "0deg 75deg 105%"
  cameraTarget    String?
  autoRotate      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facility Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  hotspots FacilityHotspot[]
}

model FacilityHotspot {
  id           String   @id @default(uuid())
  experienceId String
  title        String
  description  String?  @db.Text
  hotspotType  String   @default("INFO") // INFO, EQUIPMENT, LINK, RESERVATION
  position     String // model-viewer data-position, e.g. "0.1m 1.2m -0.5m", or "yaw pitch" for panoramas
  normal       String?
  linkUrl      String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience FacilityExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

// ----------------------------------------------------------------------------
// DOCUMENT CENTER (polymorphic document registry over the Media storage)
// ----------------------------------------------------------------------------

model Document {
  id           String   @id @default(uuid())
  title        String
  description  String?
  category     String   @default("GENERAL") // GENERAL, CONTRACT, INVOICE, APPLICATION, IDENTITY, FINANCIAL, LEGAL, PRESENTATION, REPORT, OTHER
  mediaId      String
  entityType   String // Person, Organization, Entrepreneur, Program, Application, Project, RentContract, InvoiceRecord, Facility
  entityId     String
  visibility   String   @default("INTERNAL") // INTERNAL, RESTRICTED
  isArchived   Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([category])
}

// Per-user read receipts for broadcast notifications (userId = null on Notification)
model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

/// Places a published form somewhere other than its own page (program page, homepage block, standalone link).
model FormPlacement {
  id          String   @id @default(uuid())
  formId      String
  targetType  String // PROGRAM_PAGE, HOMEPAGE, STANDALONE, SUPPORTS_PAGE, SPACES_PAGE
  targetId    String? // e.g. program id for PROGRAM_PAGE
  title       String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([targetType, targetId])
}

/// A task passed from one admin to another ("iş paslama"). The task is reassigned immediately;
/// the receiver accepts it or returns it to the sender with a note.
model TaskHandoff {
  id           String    @id @default(uuid())
  taskId       String
  fromUserId   String
  toUserId     String
  note         String?   @db.Text
  status       String    @default("PENDING") // PENDING, ACCEPTED, RETURNED
  responseNote String?   @db.Text
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser User @relation("HandoffFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("HandoffTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([toUserId, status])
  @@index([fromUserId])
  @@index([createdAt])
}

/// Time spent on a task or a personal to-do. A running timer has endedAt = null.
model TaskTimeEntry {
  id        String    @id @default(uuid())
  userId    String
  taskId    String?
  todoId    String?
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int       @default(0)
  note      String?
  source    String    @default("TIMER") // TIMER, MANUAL
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  todo PersonalTodo? @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([taskId])
  @@index([todoId])
}

// ============================================================================
// WORK OS: teams, watchers, templates, automations
// ============================================================================

model WorkTeam {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#7c3aed")
  icon        String?
  leadUserId  String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead      User?            @relation("WorkTeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  members   WorkTeamMember[]
  tasks     Task[]
  templates TaskTemplate[]

  @@index([isActive])
}

model WorkTeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("MEMBER") // LEAD, MEMBER
  createdAt DateTime @default(now())

  team WorkTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  teamId         String?
  title          String
  body           String?  @db.Text
  priority       String   @default("MEDIUM")
  checklistJson  String?  @db.Text // ["Adım 1", "Adım 2"]
  subTasksJson   String?  @db.Text // ["Alt görev 1", ...]
  estimatedHours Float?
  dueInDays      Int?
  recurrence     String?
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team WorkTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

// ============================================================================
// INTEGRATION HUB: connections, logs, outgoing webhooks, API keys
// Secrets are stored encrypted (AES-256-GCM, INTEGRATION_ENCRYPTION_KEY).
// ============================================================================

model IntegrationConnection {
  id          String    @id @default(uuid())
  provider    String // KOSGEB, TUBITAK, GIB_EINVOICE, PARASUT, LOGO, MIKRO, BANK, SMS, SLACK, TEAMS, GOOGLE, CUSTOM_REST
  name        String
  category    String // PUBLIC_AGENCY, ACCOUNTING, BANK, MESSAGING, PRODUCTIVITY, CUSTOM
  baseUrl     String?
  authType    String    @default("NONE") // NONE, API_KEY_HEADER, BEARER, BASIC, QUERY_KEY
  configJson  String?   @db.Text // non-secret settings (header name, test path, notes)
  secretEnc   String?   @db.Text // encrypted secret payload
  status      String    @default("NOT_CONFIGURED") // NOT_CONFIGURED, CONFIGURED, ACTIVE, ERROR, DISABLED
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  lastError   String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs IntegrationLog[]

  @@index([provider])
  @@index([status])
}

model IntegrationLog {
  id           String   @id @default(uuid())
  connectionId String?
  webhookId    String?
  direction    String // OUTBOUND, INBOUND, WEBHOOK
  method       String
  url          String
  statusCode   Int?
  durationMs   Int?
  ok           Boolean
  error        String?
  summary      String?
  createdAt    DateTime @default(now())

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@index([webhookId, createdAt])
}

model WebhookSubscription {
  id              String    @id @default(uuid())
  name            String
  url             String
  eventsJson      String    @db.Text // ["application.created", ...]
  secretEnc       String    @db.Text
  isActive        Boolean   @default(true)
  lastStatus      Int?
  lastDeliveredAt DateTime?
  failureCount    Int       @default(0)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  keyHash     String    @unique
  scopesJson  String    @db.Text // ["applications:read", ...]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([revokedAt])
}

// ============================================================================
// PRE-ACCOUNTING (ön muhasebe): parties, cash / bank accounts, sales invoices,
// collections / payments. Amounts are rounded to 2 decimals in the service layer.
// ============================================================================

model FinanceParty {
  id             String   @id @default(uuid())
  kind           String   @default("CUSTOMER") // CUSTOMER, SUPPLIER, BOTH
  name           String
  taxNumber      String? // VKN / TCKN is never stored here; use VKN for companies
  taxOffice      String?
  email          String?
  phone          String?
  address        String?  @db.Text
  iban           String?
  organizationId String?
  entrepreneurId String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesInvoices SalesInvoice[]
  movements     FinanceMovement[]

  @@index([kind])
  @@index([name])
}

model FinanceAccount {
  id             String   @id @default(uuid())
  name           String
  kind           String   @default("BANK") // CASH, BANK, POS, OTHER
  currency       String   @default("TRY")
  bankName       String?
  iban           String?
  openingBalance Float    @default(0)
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements FinanceMovement[]
}

model SalesInvoice {
  id               String    @id @default(uuid())
  number           String    @unique
  partyId          String
  issueDate        DateTime
  dueDate          DateTime?
  currency         String    @default("TRY")
  status           String    @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_PAID, PAID, CANCELLED
  subtotal         Float     @default(0)
  discountTotal    Float     @default(0)
  vatTotal         Float     @default(0)
  withholdingRate  Float     @default(0) // KDV tevkifatı oranı (0, 2/10 … 10/10 as 0.2 … 1)
  withholdingTotal Float     @default(0)
  grandTotal       Float     @default(0)
  paidAmount       Float     @default(0)
  notes            String?   @db.Text
  eInvoiceStatus   String    @default("NONE") // NONE, PENDING_EXTERNAL_CONFIGURATION, QUEUED, SENT, ACCEPTED, REJECTED
  eInvoiceUuid     String?
  sourceType       String? // RENT, RESERVATION, MACHINE, SERVICE, OTHER
  sourceId         String?
  createdById      String
  issuedAt         DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  party     FinanceParty       @relation(fields: [partyId], references: [id], onDelete: Restrict)
  lines     SalesInvoiceLine[]
  movements FinanceMovement[]

  @@index([partyId])
  @@index([status])
  @@index([issueDate])
}

model SalesInvoiceLine {
  id           String @id @default(uuid())
  invoiceId    String
  description  String
  quantity     Float  @default(1)
  unit         String @default("Adet")
  unitPrice    Float  @default(0)
  discountRate Float  @default(0) // percent
  vatRate      Float  @default(20) // percent: 0, 1, 10, 20
  lineNet      Float  @default(0)
  vatAmount    Float  @default(0)
  sortOrder    Int    @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model FinanceMovement {
  id                String   @id @default(uuid())
  kind              String // COLLECTION, PAYMENT, INCOME, EXPENSE, TRANSFER_IN, TRANSFER_OUT
  accountId         String
  partyId           String?
  salesInvoiceId    String?
  purchaseInvoiceId String? // InvoiceRecord (incoming invoice)
  transferGroupId   String?
  amount            Float
  currency          String   @default("TRY")
  date              DateTime
  category          String?
  description       String?
  documentNo        String?
  createdById       String
  createdAt         DateTime @default(now())

  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  party        FinanceParty?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  salesInvoice SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
  @@index([partyId])
  @@index([salesInvoiceId])
  @@index([kind])
}
