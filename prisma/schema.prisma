  partyBContactPhone  String?
  status              String    @default("DRAFT") // DRAFT, IN_REVIEW, SIGNED, ACTIVE, EXPIRED, TERMINATED
  startDate           DateTime
  endDate             DateTime?
  autoRenew           Boolean   @default(false)
  renewalReminderDays Int       @default(30)
  isRenewalAlertSent  Boolean   @default(false)
  responsibleUserId   String?
